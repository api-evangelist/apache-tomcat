  "info": {
    "_postman_id": "90a8bff6-a0b5-41c4-9499-fcefefbcb68a",
    "name": "Apache Tomcat Manager Text applications API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Apache Tomcat Manager web application exposes a text-based HTTP API for deploying, undeploying, listing, starting, stopping, and inspecting web applications running inside a Tomcat server. All commands require HTTP Basic authentication by a user holding the `manager-script` role. Responses are plain text where the first line begins with `OK -` on success or `FAIL -` on error.\n\nContact Support:\n Name: Apache Tomcat",
      "type": "text/plain"
    }
  }
